# ==========================================
# WINDOWSEVEN MD — Environment Configuration
# ==========================================

# Application Settings
NODE_ENV=development
PORT=3000
BOT_NAME="Windowseven MD"
BOT_OWNER="Windowseven Admin"
PACK_NAME="Windowseven MD"
PACK_AUTHOR="Windowseven"

# Database Configuration (PostgreSQL authoritative store)
# Production / Development:
DATABASE_URL=postgresql://user:password@localhost:5432/windowseven
# Isolated Test Database:
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/windowseven_test

# Legacy transitional fallback number (without '+' or spaces, e.g. 255712345678)
# NOTE: This is NOT the future SaaS authorization model.
OWNER_NUMBER=
BOT_PHONE_NUMBER=

# Runtime Tuning
COMMAND_MODE=public
MAX_STORE_MESSAGES=20
STORE_WRITE_INTERVAL=10000
WARN_COUNT=3

# External Third-Party APIs (Optional features will disable gracefully if not set)
NEWS_API_KEY=
OPENWEATHER_API_KEY=
GIPHY_API_KEY=
PRINCETECH_API_KEY=
LOLHUMAN_API_KEY=
XTEAM_API_KEY=
NEOXR_API_KEY=
VIOLETICS_API_KEY=
ZENZAPIS_API_KEY=
FGMODS_API_KEY=
SHIZO_API_KEY=

# Custom Third-Party Base URLs (optional overrides)
XTEAM_API_URL=https://api.xteam.xyz
LOLHUMAN_API_URL=https://api.lolhuman.xyz
NEOXR_API_URL=https://api.neoxr.my.id
VIOLETICS_API_URL=https://violetics.pw
ZENZAPIS_API_URL=https://zenzapis.xyz
FGMODS_API_URL=https://api-fgmods.ddns.net
SHIZO_API_URL=https://shizoapi.onrender.com
PRINCETECH_API_URL=https://api.princetechn.com
